{
  "name": "compass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "next dev -p 5173",
    "dev:web": "cross-env NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8787 NEXT_PUBLIC_API_BASE_URL=http://localhost:8787 next dev -p 5173",
    "dev:all": "concurrently -n web,backend -c blue,magenta \"npm:dev:web\" \"npm:backend\"",
    "backend": "npm --workspace @platform/reference-backend run start",
    "mock-ws": "npm run backend",
    "build-fixtures": "npm --workspace @platform/reference-backend exec tsx src/build-fixtures.ts",
    "sync:atlas": "tsx tools/snapshots/build-atlas-snapshot.ts",
    "build": "next build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "next start -p 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && npm --workspace @platform/contracts run typecheck && npm --workspace @platform/engine run typecheck && npm --workspace @platform/reference-backend run typecheck"
  },
  "dependencies": {
    "@platform/contracts": "*",
    "@platform/engine": "*",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.13.24",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "next": "^15.5.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.0",
    "react-use-websocket": "^4.13.0",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.19",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  }
}
