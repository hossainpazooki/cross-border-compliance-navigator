# API Configuration — REST origin for /v2/intents and the /audit/{id} replay path.
# Local default (when unset) is the @platform/reference-backend on :8787, the
# backend booted by `npm run dev:all`. Set this explicitly in production to the
# deployed backend origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Live-session WebSocket base. The hook appends `/v2/ws/trade/{intent_id}`.
# Defaults to ws://localhost:8787 (reference-backend) when unset. In production
# this is the same host as NEXT_PUBLIC_API_BASE_URL but as ws:// / wss://.
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8787

# Optional: explicit stream-transport override ('ws' | 'sse').
# NEXT_PUBLIC_STREAM_TRANSPORT=ws

# ATLAS live-verification rewire seam — DORMANT by default.
# COMPASS surfaces ATLAS rule-artifact provenance from a static snapshot today;
# it does NOT verify the cryptography. This flag is the post-Gate-5 seam for
# live verification under ATLAS ADR-0019 (fail-closed): a non-Published pack is
# blocked even with valid crypto, and an unavailable/Unknown registry blocks.
# Unset (the default) => snapshot mode, status renders as "Not verified
# (snapshot)". Set to "true" to attempt live verification.
# The feature stays dormant until @platform/atlas-artifact ships to npm.
# NEXT_PUBLIC_USE_WASM_VERIFY=true

# Base URL of a reachable `ke-cli serve` registry surface (the ATLAS verify API).
# Required when NEXT_PUBLIC_USE_WASM_VERIFY=true and you want the HTTP "serve"
# verify path (POST /verify, GET /healthz). When the flag is on but this is
# unset, only the in-browser WASM path remains — which is blocked until
# @platform/atlas-artifact publishes a browser build.
# NEXT_PUBLIC_ATLAS_REGISTRY_URL=http://localhost:8788
