# API Configuration — institutional-defi-platform-api (uvicorn default)
# Used by both REST (/v2/intents) and the audit replay path.
VITE_API_URL=http://localhost:8000

# Live-session WebSocket base. In production this is the same host as VITE_API_URL
# but as ws:// — the hook appends `/v2/ws/trade/{intent_id}`. Defaults to the
# local mock-ws server when unset.
# VITE_WS_URL=ws://localhost:8000

# Optional: Enable debug mode
VITE_DEBUG=false
